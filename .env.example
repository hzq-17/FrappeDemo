# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 说明：Windows + 受限网络环境的推荐值写在本文件末尾的注释里。
# ---------------------------------------------------------------------------

# 站点与账号
SITE_NAME=growth.local
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin

# 端口
HTTP_PORT=8000
SOCKETIO_PORT=9000

# 数据初始化
SEED_DATA=1
SEED_MONTHS=24
SEED_RESET=0

# 框架版本
FRAPPE_BRANCH=version-15

# 镜像源（Docker Hub 不可达时改为可用镜像站）
BASE_IMAGE=debian:bookworm-slim
MARIADB_IMAGE=mariadb:10.6
REDIS_IMAGE=redis:6.2-alpine

# 包源
APT_MIRROR=deb.debian.org
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
NPM_REGISTRY=https://registry.npmjs.org

# 是否安装 headless chromium（用于页面视觉验证，1=安装 0=跳过）
INSTALL_BROWSER=1

# 构建期代理：仅在 GitHub 不可达时需要填写（容器内通过 host.docker.internal 访问宿主机代理）
# 例：BUILD_HTTP_PROXY=http://host.docker.internal:7897
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=

# ---------------------------------------------------------------------------
# 受限网络（中国大陆常见）参考值：
#   BASE_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim
#   MARIADB_IMAGE=docker.m.daocloud.io/library/mariadb:10.6
#   REDIS_IMAGE=docker.m.daocloud.io/library/redis:6.2-alpine
#   APT_MIRROR=repo.huaweicloud.com
#   PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
#   PIP_EXTRA_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
#   BUILD_HTTP_PROXY=http://host.docker.internal:7897
#   BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# ---------------------------------------------------------------------------
